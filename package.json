{
  "name": "edulense-react-native",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development expo start",
    "android": "cross-env NODE_ENV=development expo run:android",
    "android:run": "cross-env NODE_ENV=development expo run:android",
    "android:clean": "cd android && gradlew --stop && cd .. && rimraf android/.gradle android/build android/app/build",
    "android:rebuild": "npm run android:clean && cd android && gradlew assembleDebug",
    "ios": "cross-env NODE_ENV=development expo run:ios",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e:build": "cross-env NODE_ENV=test detox build -c android.emu.release",
    "e2e:test": "cross-env NODE_ENV=test detox test -c android.emu.release"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "^54.0.33",
    "expo-asset": "~12.0.12",
    "expo-secure-store": "~15.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^10.1.0",
    "detox": "^20.47.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "jest-circus": "^30.2.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.6.0"
  }
}
